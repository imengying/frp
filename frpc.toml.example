# frpc 配置示例。字段名与官方 frp 一致，未写的项都用默认值。
# 完整选项说明见 README。

serverAddr = "127.0.0.1"
serverPort = 7000
token = "change-me"

[[proxies]]
name = "test-tcp"
type = "tcp"
localIP = "127.0.0.1"
localPort = 22
remotePort = 6000

# 其它可选配置（取消注释即可启用）：
#
# 连接池：预先建立空闲连接，访问时直接复用（默认 0 = 不用）
# poolCount = 2
#
# 健康检查：本地服务挂了就释放远端端口，恢复后自动重新注册（默认关闭）
# [proxies.healthCheck]
# type = "tcp"
# intervalSeconds = 10
# timeoutSeconds = 3
# maxFailed = 1
#
# 透传访客真实 IP，本地服务需支持 PROXY protocol（默认关闭）
# proxyProtocolVersion = "v1"
#
# [transport]
# heartbeatInterval = 30
# dialServerTimeout = 10
# dialLocalTimeout = 10
# tcpKeepalive = 60
#
# [log]
# level = "info"
