# frps 配置示例。字段名与官方 frp 一致，未写的项都用默认值。
# 完整选项说明见 README。

bindPort = 7000
token = "change-me"

# 允许客户端申请的远端端口，不配置 = 不限制。
allowPorts = "6000-6010,7000"
# 与 frp 相同的数组写法，等价于上面：
# allowPorts = [
#     { start = 6000, end = 6010 },
#     { single = 7000 },
# ]

# 其它可选配置（把每段前的注释去掉即可启用）：
#
# bindAddr = "0.0.0.0"
# proxyBindAddr = "0.0.0.0"
# maxPortsPerClient = 0
# maxPoolCount = 0
#
# [transport]
# heartbeatTimeout = 90
# workConnTimeout = 10
# tcpKeepalive = 60
#
# [log]
# level = "info"
