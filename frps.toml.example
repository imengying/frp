# frps —— frp 服务端配置示例（TCP 版）
#
# 用法: frps -c /etc/frp/frps.toml
# 校验配置: frps -c /etc/frp/frps.toml --check

# ---------------------------------------------------------------- 监听

# 控制端口绑定的地址。客户端连到这里做认证与心跳。
# 只想让内网客户端接入、不对外暴露控制端口时，改成具体的内网 IP。
bind_addr = "0.0.0.0"
# 控制端口
bind_port = 7000

# 代理端口（对外提供服务的端口）单独绑定的地址。
# 留空 = 与 bind_addr 相同。
# 典型用法：控制端口只在内网，代理端口绑公网：
#   bind_addr = "10.0.0.5"        # 内网地址
#   proxy_bind_addr = "0.0.0.0"   # 公网地址
proxy_bind_addr = ""

# ---------------------------------------------------------------- 认证

# 全局认证 token，必须与客户端配置一致。
# 建议用随机串，例如: openssl rand -hex 32
token = "change-me-to-a-random-string"

# ---------------------------------------------------------------- 配额

# 允许客户端申请的远端端口，用逗号分隔，支持单个端口与区间。
# 留空 "" = 不限制（不推荐，客户端可以占用任意端口）。
allow_ports = "6000-6010,8000-8100"

# 每个客户端最多能注册多少个代理。0 = 不限制。
max_ports_per_client = 0

# 每个代理的连接池上限，会覆盖客户端申请的 pool_count。
# 0 = 由客户端自己决定。
# 设为较小的值可以限制客户端预留的空闲连接数，避免资源被单个客户端吃满。
max_pool_count = 0

# ---------------------------------------------------------------- 超时与保活

# 超过该秒数没收到客户端心跳就判定它离线，释放它的代理端口。
# 客户端心跳间隔通常是这个值的 1/3。
heartbeat_timeout = 90

# 有公网访问进来、等着客户端建立工作连接的超时（秒）。
# 客户端网络慢可以适当调大。
work_conn_timeout = 10

# TCP keepalive 探测间隔（秒），用于发现被 NAT/防火墙静默丢弃的半开连接。
# 0 = 用系统默认。
tcp_keepalive = 60

# ---------------------------------------------------------------- 日志

# trace / debug / info / warn / error
# 环境变量 RUST_LOG 优先级更高，可临时只开某个模块的调试日志，
# 例如定位「某个代理为什么连不上」：RUST_LOG=frp_server::server=debug frps -c frps.toml
log_level = "info"
