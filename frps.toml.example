# frps 配置示例。未写的项都用默认值，完整选项说明见 README。

# 控制端口（客户端连这里）
bind_addr = "0.0.0.0"
bind_port = 7000

# 全局 token，必须与客户端一致
token = "change-me"

# 允许客户端申请的远端端口，留空 = 不限制
allow_ports = "6000-6010"

# 代理端口单独绑定的地址，留空 = 与 bind_addr 相同。
# 控制端口只走内网时用得上：
#   bind_addr = "10.0.0.5"
#   proxy_bind_addr = "0.0.0.0"
# proxy_bind_addr = ""
